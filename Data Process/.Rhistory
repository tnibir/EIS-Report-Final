read_parquet("./Commuting/points.parquet")
get_wd()
gwd()
getwd()
read_parquet(getwd(),"Commuting/points.parquet")
read_parquet(file.path(getwd(),"Commuting/points.parquet"))
getwd()
library("here")
install.packages("here")
library("here")
df <- read_parquet(here("Commuting", "points.parquet"))
getwd()
df <- read_parquet(here("Output", "points.parquet"))
read_parquet(file.path(getwd(),"Output/points.parquet"))
library(here)
df <- read_parquet(here("Output", "points.parquet"))
df
df
View(df)
df <- read_parquet(file.path(getwd(),"Output/points.parquet"))
View(df)
points <- read_parquet(here("Output", "points.parquet"))
paths <- read_parquet(here("Output", "paths.parquet"))
View(paths)
processing_log_df
dir.exists(rta_dir)
dir.exists(!rta_dir)
dir.exists(rta_dir)
!dir.exists(rta_dir)
