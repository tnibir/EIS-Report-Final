library(sf)
library(arrow)
library(dplyr)
library(tibble)
project_root <- getwd()
project_root
rta_dir <- file.path(project_root, "RTA")
commuting_dir <- file.path(project_root, "Commuting")
output_dir <- file.path(project_root, "output")
output_dir <- file.path(project_root, "Output")
dir.create(Output_dir, showWarnings = FALSE, recursive = TRUE)
Output_dir <- file.path(project_root, "Output")
dir.create(Output_dir, showWarnings = FALSE, recursive = TRUE)
if (!dir.exists(rta_dir)) {
stop("RTA folder not found: ", rta_dir)
}
if (!dir.exists(commuting_dir)) {
stop("Commuting folder not found: ", commuting_dir)
}
rta_files <- list.files(
rta_dir,
pattern = "\\.kmz$",
full.names = TRUE,
recursive = TRUE,
ignore.case = TRUE
)
# ============================================================
# KMZ TO PARQUET PROCESSOR
# Sources: RTA and Commuting
# ============================================================
# Install required packages once if needed:
# install.packages(c("sf", "arrow", "dplyr", "tibble"))
library(sf)
library(arrow)
library(dplyr)
library(tibble)
# ------------------------------------------------------------
# 1. PROJECT CONFIGURATION
# ------------------------------------------------------------
project_root <- getwd()
rta_dir <- file.path(project_root, "RTA")
commuting_dir <- file.path(project_root, "Commuting")
Output_dir <- file.path(project_root, "Output")
dir.create(Output_dir, showWarnings = FALSE, recursive = TRUE)
if (!dir.exists(rta_dir)) {
stop("RTA folder not found: ", rta_dir)
}
if (!dir.exists(commuting_dir)) {
stop("Commuting folder not found: ", commuting_dir)
}
# ------------------------------------------------------------
# 2. DISCOVER KMZ FILES
# ------------------------------------------------------------
rta_files <- list.files(
rta_dir,
pattern = "\\.kmz$",
full.names = TRUE,
recursive = TRUE,
ignore.case = TRUE
)
commuting_files <- list.files(
commuting_dir,
pattern = "\\.kmz$",
full.names = TRUE,
recursive = TRUE,
ignore.case = TRUE
)
file_manifest <- bind_rows(
tibble(File = rta_files, Source = "RTA"),
tibble(File = commuting_files, Source = "Commuting")
)
if (nrow(file_manifest) == 0) {
stop("No KMZ files found in RTA or Commuting.")
}
message("RTA KMZ files: ", length(rta_files))
message("Commuting KMZ files: ", length(commuting_files))
# ------------------------------------------------------------
# 3. HELPER: READ ONE KMZ FILE
# ------------------------------------------------------------
read_one_kmz <- function(file, source) {
message("\nProcessing: ", file)
temp_dir <- tempfile("kmz_")
dir.create(temp_dir)
on.exit(
unlink(temp_dir, recursive = TRUE),
add = TRUE
)
extracted_files <- tryCatch(
utils::unzip(file, exdir = temp_dir),
error = function(e) {
warning("Could not extract ", file, ": ",
conditionMessage(e))
character(0)
}
)
kml_files <- list.files(
temp_dir,
pattern = "\\.kml$",
full.names = TRUE,
recursive = TRUE,
ignore.case = TRUE
)
if (length(kml_files) == 0) {
warning("No KML file found inside: ", file)
return(list())
}
results <- list()
for (kml_file in kml_files) {
layers <- tryCatch(
sf::st_layers(kml_file)$name,
error = function(e) {
warning("Could not inspect KML: ", kml_file,
" | ", conditionMessage(e))
character(0)
}
)
for (layer in layers) {
message("  Reading layer: ", layer)
dat <- tryCatch(
sf::st_read(
kml_file,
layer = layer,
quiet = TRUE
),
error = function(e) {
warning("Could not read layer ", layer,
" in ", kml_file, ": ",
conditionMessage(e))
NULL
}
)
if (is.null(dat) || nrow(dat) == 0) {
next
}
# Preserve source information.
dat$Source <- source
dat$Source_File <- basename(file)
dat$KML_Layer <- layer
# Relative file path within the source folder.
source_root <- if (source == "RTA") {
rta_dir
} else {
commuting_dir
}
normalized_file <- normalizePath(
file,
winslash = "/",
mustWork = TRUE
)
normalized_root <- normalizePath(
source_root,
winslash = "/",
mustWork = TRUE
)
dat$Source_Relative_Path <- substring(
normalized_file,
nchar(normalized_root) + 2
)
# Stable feature ID within this input file and layer.
dat$Feature_ID <- paste(
source,
tools::file_path_sans_ext(basename(file)),
make.names(layer),
seq_len(nrow(dat)),
sep = "_"
)
# Normalize common existing Path Key column names.
key_match <- which(
tolower(trimws(names(dat))) %in%
c("path key", "path_key", "pathkey")
)
if (length(key_match) > 0 &&
names(dat)[key_match[1]] != "Path Key") {
names(dat)[key_match[1]] <- "Path Key"
}
results[[length(results) + 1]] <- dat
}
}
results
}
# ------------------------------------------------------------
# 4. PROCESS ALL KMZ FILES
# ------------------------------------------------------------
all_results <- list()
processing_log <- list()
for (i in seq_len(nrow(file_manifest))) {
current_file <- file_manifest$File[i]
current_source <- file_manifest$Source[i]
result <- tryCatch(
read_one_kmz(current_file, current_source),
error = function(e) {
warning("Failed to process ", current_file,
": ", conditionMessage(e))
list()
}
)
all_results <- c(all_results, result)
processing_log[[length(processing_log) + 1]] <- tibble(
File = current_file,
Source = current_source,
Status = if (length(result) > 0) {
"Features extracted"
} else {
"No features extracted"
},
Feature_Count = sum(vapply(
result,
nrow,
integer(1)
))
)
}
if (length(all_results) == 0) {
stop("No spatial features could be extracted from the KMZ files.")
}
# ------------------------------------------------------------
# 5. COMBINE FEATURES
# ------------------------------------------------------------
all_features <- do.call(
dplyr::bind_rows,
all_results
)
message("\nTotal extracted features: ", nrow(all_features))
# Identify geometry types.
geom_type <- as.character(
sf::st_geometry_type(all_features)
)
is_path <- geom_type %in%
c("LINESTRING", "MULTILINESTRING")
is_point <- geom_type %in%
c("POINT", "MULTIPOINT")
# ------------------------------------------------------------
# 6. STANDARDIZE PATH KEY
# ------------------------------------------------------------
if (!"Path Key" %in% names(all_features)) {
all_features[["Path Key"]] <- NA_character_
}
all_features[["Path Key"]] <- as.character(
all_features[["Path Key"]]
)
missing_key <- is_path & (
is.na(all_features[["Path Key"]]) |
trimws(all_features[["Path Key"]]) == ""
)
# Fallback identifier only. This does not establish a
# relationship between separate paths and point features.
all_features[["Path Key"]][missing_key] <-
all_features$Feature_ID[missing_key]
# ------------------------------------------------------------
# 7. HELPER: EXPORT FEATURES WITH WKT GEOMETRY
# ------------------------------------------------------------
export_parquet <- function(spatial_data, output_file) {
if (nrow(spatial_data) == 0) {
message("Skipping empty dataset: ", output_file)
return(invisible(NULL))
}
# Keep all attributes and serialize geometry as WKT.
output_data <- sf::st_drop_geometry(spatial_data)
output_data$Geometry_WKT <- sf::st_as_text(
sf::st_geometry(spatial_data)
)
# Convert factors to strings.
for (nm in names(output_data)) {
if (is.factor(output_data[[nm]])) {
output_data[[nm]] <- as.character(output_data[[nm]])
}
}
arrow::write_parquet(
output_data,
output_file,
compression = "zstd"
)
message("Written: ", output_file)
invisible(NULL)
}
# ------------------------------------------------------------
# 8. EXPORT ALL FEATURES
# ------------------------------------------------------------
export_parquet(
all_features,
file.path(output_dir, "all_features.parquet")
)
# ------------------------------------------------------------
# 9. EXPORT PATHS
# ------------------------------------------------------------
paths_sf <- all_features[is_path, ]
export_parquet(
paths_sf,
file.path(output_dir, "paths.parquet")
)
# ------------------------------------------------------------
# 10. EXPORT POINTS
# ------------------------------------------------------------
points_sf <- all_features[is_point, ]
export_parquet(
points_sf,
file.path(output_dir, "points.parquet")
)
# ------------------------------------------------------------
# 11. EXPORT PROCESSING SUMMARY
# ------------------------------------------------------------
summary_table <- tibble(
Source = c("RTA", "Commuting"),
KMZ_Files = c(
length(rta_files),
length(commuting_files)
),
Features = c(
sum(all_features$Source == "RTA"),
sum(all_features$Source == "Commuting")
),
Paths = c(
sum(all_features$Source == "RTA" & is_path),
sum(all_features$Source == "Commuting" & is_path)
),
Points = c(
sum(all_features$Source == "RTA" & is_point),
sum(all_features$Source == "Commuting" & is_point)
)
)
print(summary_table)
write.csv(
summary_table,
file.path(output_dir, "processing_summary.csv"),
row.names = FALSE
)
# Save per-file processing results.
processing_log_df <- bind_rows(processing_log)
write.csv(
processing_log_df,
file.path(output_dir, "processing_log.csv"),
row.names = FALSE
)
# Save the input manifest.
write.csv(
file_manifest,
file.path(output_dir, "input_manifest.csv"),
row.names = FALSE
)
# ------------------------------------------------------------
# 12. FINISH
# ------------------------------------------------------------
message("\n========================================")
message("KMZ PROCESSING COMPLETED")
message("========================================")
message("Output directory: ", output_dir)
message("Files generated:")
message("  all_features.parquet")
message("  paths.parquet")
message("  points.parquet")
message("  processing_summary.csv")
message("  processing_log.csv")
message("  input_manifest.csv")
message("========================================")
